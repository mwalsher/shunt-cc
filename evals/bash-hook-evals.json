{
  "description": "Evals for the Bash hook (shunt-hook bash). Adapted from spotify/portal-ai-plugins shunt bash-hook-evals.json, plus rtk, compound-command and recursion cases. `command` is shorthand for input.tool_input.command; `via_rtk` first runs the real `rtk hook claude` and feeds its rewritten command to shunt (skipped if rtk is not installed).",
  "hook_mode": "bash",
  "evals": [
    { "name": "cat-large-file", "command": "cat {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "Plain cat on large file", "reason_contains": ["bulk-read", "offset/limit", "`cat`"] },
    { "name": "cat-small-file", "command": "cat {{FIXTURES}}/small.txt", "expected_decision": "allow", "reason": "Small file" },
    { "name": "cat-boundary", "command": "cat {{FIXTURES}}/boundary.txt", "expected_decision": "allow", "reason": "Exactly at threshold" },
    { "name": "cat-just-over", "command": "cat {{FIXTURES}}/over.txt", "expected_decision": "deny", "reason": "One line over threshold" },
    { "name": "cat-with-flag", "command": "cat -n {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "cat -n still a full read" },
    { "name": "cat-quoted-path", "command": "cat \"{{FIXTURES}}/large.txt\"", "expected_decision": "deny", "reason": "Quoted path" },
    { "name": "cat-path-with-space", "command": "cat '{{FIXTURES}}/dir with space/large.txt'", "expected_decision": "deny", "reason": "Quoted path containing a space" },
    { "name": "cat-absolute-binary", "command": "/bin/cat {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "cat invoked by absolute path" },
    { "name": "cat-second-file-large", "command": "cat {{FIXTURES}}/small.txt {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "Every file argument is checked, not just the first" },
    { "name": "cat-glob", "command": "cat {{FIXTURES}}/lar*.txt", "expected_decision": "deny", "reason": "Globs are expanded" },
    { "name": "cat-stdin-redirect", "command": "cat < {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "Input redirect still reads the file into context" },
    { "name": "cat-binary", "command": "cat {{FIXTURES}}/image.bin", "expected_decision": "allow", "reason": "Binary file: not a text read" },
    { "name": "cat-nonexistent", "command": "cat /tmp/shunt-does-not-exist.txt", "expected_decision": "allow", "reason": "Missing file: let Bash report the error" },
    { "name": "cat-directory", "command": "cat {{FIXTURES}}/subdir", "expected_decision": "allow", "reason": "Directory: let Bash report the error" },

    { "name": "head-large-file-default", "command": "head {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "CHANGED from shunt: head prints 10 lines, a bounded read like Read+limit" },
    { "name": "head-with-count", "command": "head -100 {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "CHANGED from shunt: 100 lines <= threshold is a bounded read" },
    { "name": "head-n-space-count", "command": "head -n 5 {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "FIXED parser: -n 5 is a count, not a path" },
    { "name": "head-count-over-threshold", "command": "head -n 5000 {{FIXTURES}}/huge.txt", "expected_decision": "deny", "reason": "head -n 5000 prints 5000 lines: a full read in disguise" },
    { "name": "head-attached-count-over", "command": "head -n700 {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "-n700 form" },
    { "name": "head-long-lines-over", "command": "head --lines=700 {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "--lines= form" },
    { "name": "head-bytes", "command": "head -c 100 {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "Byte range is bounded" },
    { "name": "tail-large-file-default", "command": "tail {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "CHANGED from shunt: tail prints 10 lines" },
    { "name": "tail-follow", "command": "tail -f {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "tail -f starts from the last 10 lines" },
    { "name": "tail-from-line-2", "command": "tail -n +2 {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "tail -n +2 prints 1199 lines" },
    { "name": "tail-from-line-700", "command": "tail -n +700 {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "tail -n +700 prints 501 lines" },
    { "name": "tail-reverse", "command": "tail -r {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "BSD tail -r prints the whole file" },
    { "name": "less-large-file", "command": "less {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "less without a TTY dumps the whole file" },
    { "name": "more-large-file", "command": "more {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "more on large file" },

    { "name": "cat-pipe", "command": "cat {{FIXTURES}}/large.txt | grep export", "expected_decision": "allow", "reason": "Piped: targeted read" },
    { "name": "cat-redirect", "command": "cat {{FIXTURES}}/large.txt > /tmp/shunt-out.txt", "expected_decision": "allow", "reason": "Redirect: copying, not reading into context" },
    { "name": "cat-append-redirect", "command": "cat {{FIXTURES}}/large.txt >> /tmp/shunt-out.txt", "expected_decision": "allow", "reason": "Append redirect" },
    { "name": "cat-redirect-all", "command": "cat {{FIXTURES}}/large.txt &>/dev/null", "expected_decision": "allow", "reason": "stdout+stderr redirected" },
    { "name": "cat-stderr-redirect-only", "command": "cat {{FIXTURES}}/large.txt 2>/dev/null", "expected_decision": "deny", "reason": "CHANGED from shunt: 2> doesn't divert stdout, the file still lands in context" },
    { "name": "cat-stderr-dup", "command": "cat {{FIXTURES}}/large.txt 2>&1", "expected_decision": "deny", "reason": "2>&1 still prints the file" },

    { "name": "compound-and", "command": "echo start && cat {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "Reads after && are checked" },
    { "name": "compound-semicolon", "command": "ls; cat {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "Reads after ; are checked" },
    { "name": "compound-newline", "command": "echo start\ncat {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "Newline-separated commands are checked" },
    { "name": "compound-pipe-elsewhere", "command": "ls | wc -l; cat {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "A pipe in another command doesn't exempt this one" },
    { "name": "compound-small", "command": "ls && cat {{FIXTURES}}/small.txt", "expected_decision": "allow", "reason": "Compound with only small reads" },
    { "name": "cd-then-relative", "command": "cd {{FIXTURES}} && cat large.txt", "expected_decision": "deny", "reason": "Relative path resolved after cd" },
    { "name": "cwd-relative", "command": "cat large.txt", "cwd": "{{FIXTURES}}", "expected_decision": "deny", "reason": "Relative path resolved against hook cwd" },
    { "name": "env-assignment-prefix", "command": "LC_ALL=C cat {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "Leading VAR=value is skipped" },
    { "name": "env-wrapper", "command": "env -i FOO=1 cat {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "env wrapper is skipped" },
    { "name": "command-wrapper", "command": "command cat {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "command builtin is skipped" },
    { "name": "echo-mentions-cat", "command": "echo \"cat {{FIXTURES}}/large.txt\"", "expected_decision": "allow", "reason": "Quoted text is not a command" },
    { "name": "non-read-command", "command": "git status", "expected_decision": "allow", "reason": "Not a file read" },
    { "name": "grep-command", "command": "grep -n 'export' {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "grep is a targeted search" },
    { "name": "bulk-read-itself", "command": "/plugins/shunt/scripts/bulk-read --question 'what?' --paths {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "The delegation script must not be blocked" },
    { "name": "empty-command", "command": "", "expected_decision": "allow", "reason": "Empty command" },
    { "name": "missing-command-field", "input": { "tool_input": {} }, "expected_decision": "allow", "reason": "No command field" },
    { "name": "unbalanced-quote", "command": "cat '{{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "Unparseable shell fails open" },

    { "name": "rtk-read-large", "command": "rtk read {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "rtk read is a full read", "reason_contains": ["`rtk read`"] },
    { "name": "rtk-read-line-numbers", "command": "rtk read -n {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "rtk read -n (rewrite of cat -n)" },
    { "name": "rtk-read-level", "command": "rtk read --level aggressive {{FIXTURES}}/huge.txt", "expected_decision": "deny", "reason": "Filtered but unbounded" },
    { "name": "rtk-read-head-lines", "command": "rtk read {{FIXTURES}}/large.txt --head-lines 50", "expected_decision": "allow", "reason": "rtk rewrite of head -50: bounded" },
    { "name": "rtk-read-head-lines-over", "command": "rtk read {{FIXTURES}}/huge.txt --head-lines 5000", "expected_decision": "deny", "reason": "Bound above threshold" },
    { "name": "rtk-read-tail-lines-eq", "command": "rtk read --tail-lines=20 {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "--tail-lines=N form" },
    { "name": "rtk-read-max-lines", "command": "rtk read -m 100 {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "Structural preview capped at 100 lines" },
    { "name": "rtk-read-multi", "command": "rtk read {{FIXTURES}}/small.txt {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "Every file checked" },
    { "name": "rtk-read-small", "command": "rtk read {{FIXTURES}}/small.txt", "expected_decision": "allow", "reason": "Small file" },
    { "name": "rtk-cat", "command": "rtk cat {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "rtk cat-style read" },
    { "name": "rtk-absolute", "command": "/opt/homebrew/bin/rtk read {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "rtk by absolute path" },
    { "name": "rtk-read-pipe", "command": "rtk read {{FIXTURES}}/large.txt | grep x", "expected_decision": "allow", "reason": "Piped" },
    { "name": "rtk-grep", "command": "rtk grep export {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "rtk grep is a search" },
    { "name": "rtk-smart", "command": "rtk smart {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "2-line summary" },
    { "name": "rtk-bypass-cat", "command": "rtk bypass cat {{FIXTURES}}/large.txt", "expected_decision": "deny", "reason": "rtk bypass runs the raw cat" },
    { "name": "rtk-bypass-head", "command": "rtk bypass head -50 {{FIXTURES}}/large.txt", "expected_decision": "allow", "reason": "rtk bypass of a bounded head" },

    { "name": "via-rtk-cat-large", "command": "cat {{FIXTURES}}/large.txt", "via_rtk": true, "expected_decision": "deny", "reason": "rtk rewrites to `rtk read`; shunt still denies" },
    { "name": "via-rtk-cat-n-large", "command": "cat -n {{FIXTURES}}/large.txt", "via_rtk": true, "expected_decision": "deny", "reason": "rtk rewrites to `rtk read -n`; shunt still denies" },
    { "name": "via-rtk-head-50", "command": "head -50 {{FIXTURES}}/large.txt", "via_rtk": true, "expected_decision": "allow", "reason": "rtk rewrites to `--head-lines 50`; bounded" },
    { "name": "via-rtk-cat-small", "command": "cat {{FIXTURES}}/small.txt", "via_rtk": true, "expected_decision": "allow", "reason": "Small file after rewrite" },

    { "name": "env-override-lower", "command": "cat {{FIXTURES}}/medium.txt", "env": { "SHUNT_MIN_LINES": "200" }, "expected_decision": "deny", "reason": "SHUNT_MIN_LINES=200: 250 lines denied" },
    { "name": "recursion-guard-cat", "command": "cat {{FIXTURES}}/huge.txt", "env": { "SHUNT_CHILD": "1" }, "expected_decision": "allow", "reason": "SHUNT_CHILD=1: hooks allow everything" },
    { "name": "recursion-guard-rtk", "command": "rtk read {{FIXTURES}}/huge.txt", "env": { "SHUNT_CHILD": "1" }, "expected_decision": "allow", "reason": "SHUNT_CHILD=1: hooks allow everything" }
  ]
}

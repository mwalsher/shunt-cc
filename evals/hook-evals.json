{
  "license": "Apache-2.0",
  "notice": "Adapted from spotify/portal-ai-plugins plugins/shunt/evals (Apache-2.0) and modified by mwalsher; see NOTICE for the changes.",
  "description": "Evals for the Read hook (shunt-hook read). Adapted from spotify/portal-ai-plugins shunt hook-evals.json; threshold default is 600 here.",
  "hook_mode": "read",
  "evals": [
    { "name": "small-file", "input": {"tool_input": {"file_path": "{{FIXTURES}}/small.txt"}}, "expected_decision": "allow", "reason": "Under threshold: delegation overhead not worth it" },
    { "name": "boundary-exact-600", "input": {"tool_input": {"file_path": "{{FIXTURES}}/boundary.txt"}}, "expected_decision": "allow", "reason": "Exactly at threshold (<=600): allow" },
    { "name": "just-over-threshold", "input": {"tool_input": {"file_path": "{{FIXTURES}}/over.txt"}}, "expected_decision": "deny", "reason": "One line over threshold: deny" },
    { "name": "over-no-trailing-newline", "input": {"tool_input": {"file_path": "{{FIXTURES}}/over-no-newline.txt"}}, "expected_decision": "deny", "reason": "601 lines without final newline counts as 601, like Read does (wc -l says 600)" },
    { "name": "large-file", "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt"}}, "expected_decision": "deny", "reason": "Well over threshold", "reason_contains": ["bulk-read", "bulk-reader", "offset/limit", "1200 lines"] },
    { "name": "very-large-file", "input": {"tool_input": {"file_path": "{{FIXTURES}}/huge.txt"}}, "expected_decision": "deny", "reason": "Very large file" },
    { "name": "path-with-space", "input": {"tool_input": {"file_path": "{{FIXTURES}}/dir with space/large.txt"}}, "expected_decision": "deny", "reason": "Spaces in path are handled" },
    { "name": "empty-file", "input": {"tool_input": {"file_path": "{{FIXTURES}}/empty.txt"}}, "expected_decision": "allow", "reason": "Empty file: nothing to delegate" },
    { "name": "targeted-read-offset", "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 100}}, "expected_decision": "deny", "reason": "CHANGED from shunt: offset alone reads to the default 2000-line limit, i.e. lines 100-1200 (1101 lines)" },
    { "name": "targeted-read-limit", "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "limit": 50}}, "expected_decision": "allow", "reason": "Limit set: targeted read" },
    { "name": "targeted-read-both", "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 100, "limit": 50}}, "expected_decision": "allow", "reason": "Offset and limit: targeted read" },
    { "name": "offset-zero", "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 0}}, "expected_decision": "deny", "reason": "CHANGED from shunt: offset:0 with no limit is a whole-file read (bypass closed)" },
    { "name": "limit-zero", "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "limit": 0}}, "expected_decision": "deny", "reason": "CHANGED from shunt: limit:0 falls back to the default limit, a whole-file read (bypass closed)" },
    { "name": "offset-near-end", "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1100}}, "expected_decision": "allow", "reason": "offset alone near the end reads 101 lines" },
    { "name": "limit-at-budget", "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 600}}, "expected_decision": "allow", "reason": "One bounded read of exactly the budget (600)" },
    { "name": "limit-over-budget", "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 601}}, "expected_decision": "deny", "reason": "One bounded read over the budget", "reason_contains": ["SHUNT_READ_BUDGET", "bulk-read"] },
    { "name": "budget-paging", "prior": [{"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 420}}], "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 421, "limit": 420}}, "expected_decision": "deny", "reason": "Paging in 420-line chunks: second chunk brings the total to 840 > 600", "reason_contains": ["840", "Paging"] },
    { "name": "budget-paging-three-chunks", "prior": [{"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 200}}, {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 201, "limit": 200}}, {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 401, "limit": 200}}], "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 601, "limit": 200}}, "expected_decision": "deny", "reason": "Fourth 200-line chunk crosses the budget" },
    { "name": "budget-reread-free", "prior": [{"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 400}}, {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 400}}, {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 100, "limit": 50}}], "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 400}}, "expected_decision": "allow", "reason": "Re-reading the same lines costs nothing" },
    { "name": "budget-overlap", "prior": [{"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 300}}], "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 250, "limit": 300}}, "expected_decision": "allow", "reason": "Overlapping reads count distinct lines: 1-549" },
    { "name": "budget-narrow-checks", "prior": [{"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 180, "limit": 30}}, {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 360, "limit": 30}}, {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 720, "limit": 30}}, {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 900, "limit": 30}}], "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1080, "limit": 30}}, "expected_decision": "allow", "reason": "Narrow verification reads (150 lines total) stay under budget" },
    { "name": "budget-per-file", "prior": [{"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 500}}], "input": {"tool_input": {"file_path": "{{FIXTURES}}/huge.txt", "offset": 1, "limit": 500}}, "expected_decision": "allow", "reason": "Budget is per file" },
    { "name": "budget-many-files", "prior": [{"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 500}}, {"tool_input": {"file_path": "{{FIXTURES}}/huge.txt", "offset": 1, "limit": 500}}, {"tool_input": {"file_path": "{{FIXTURES}}/dir with space/large.txt", "offset": 1, "limit": 500}}, {"tool_input": {"file_path": "{{FIXTURES}}/small.txt"}}], "input": {"tool_input": {"file_path": "{{FIXTURES}}/over.txt", "offset": 1, "limit": 500}}, "expected_decision": "allow", "reason": "No cross-file limit: 500 lines from each of four large files (2000 total) in one session" },
    { "name": "budget-per-session", "prior": [{"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 500}, "session_id": "other-session"}], "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 501, "limit": 500}}, "expected_decision": "allow", "reason": "Budget is per session" },
    { "name": "budget-no-session-id", "session_id": null, "prior": [{"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 500}}], "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 501, "limit": 500}}, "expected_decision": "allow", "reason": "No session_id: no ledger, only the per-read check (documented limitation)" },
    { "name": "budget-env-override", "env": {"SHUNT_READ_BUDGET": "1000"}, "prior": [{"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 1, "limit": 420}}], "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "offset": 421, "limit": 420}}, "expected_decision": "allow", "reason": "SHUNT_READ_BUDGET=1000 allows 840 lines" },
    { "name": "budget-small-file-exempt", "prior": [{"tool_input": {"file_path": "{{FIXTURES}}/boundary.txt", "offset": 1, "limit": 400}}], "input": {"tool_input": {"file_path": "{{FIXTURES}}/boundary.txt", "offset": 1, "limit": 600}}, "expected_decision": "allow", "reason": "Files at or under SHUNT_MIN_LINES have no budget" },
    { "name": "pdf-pages", "input": {"tool_input": {"file_path": "{{FIXTURES}}/large.txt", "pages": "1-3"}}, "expected_decision": "allow", "reason": "Page range is a targeted read" },
    { "name": "nonexistent-file", "input": {"tool_input": {"file_path": "/tmp/shunt-does-not-exist.txt"}}, "expected_decision": "allow", "reason": "Missing path: let Read report the error" },
    { "name": "directory", "input": {"tool_input": {"file_path": "{{FIXTURES}}/subdir"}}, "expected_decision": "allow", "reason": "Directory: let Read report the error" },
    { "name": "binary-file", "input": {"tool_input": {"file_path": "{{FIXTURES}}/image.bin"}}, "expected_decision": "allow", "reason": "Binary (images, PDFs): Read handles these natively" },
    { "name": "empty-filepath", "input": {"tool_input": {"file_path": ""}}, "expected_decision": "allow", "reason": "Empty path: pass through" },
    { "name": "missing-filepath-field", "input": {"tool_input": {}}, "expected_decision": "allow", "reason": "No file_path: pass through" },
    { "name": "malformed-json", "raw_input": "{not json", "expected_decision": "allow", "reason": "Unparseable input fails open" },
    { "name": "env-override-lower", "input": {"tool_input": {"file_path": "{{FIXTURES}}/medium.txt"}}, "env": {"SHUNT_MIN_LINES": "200"}, "expected_decision": "deny", "reason": "SHUNT_MIN_LINES=200: 250-line file denied" },
    { "name": "env-override-higher", "input": {"tool_input": {"file_path": "{{FIXTURES}}/over.txt"}}, "env": {"SHUNT_MIN_LINES": "700"}, "expected_decision": "allow", "reason": "SHUNT_MIN_LINES=700: 601-line file allowed" },
    { "name": "env-non-numeric-fallback", "input": {"tool_input": {"file_path": "{{FIXTURES}}/over.txt"}}, "env": {"SHUNT_MIN_LINES": "abc"}, "expected_decision": "deny", "reason": "Non-numeric SHUNT_MIN_LINES falls back to 600" },
    { "name": "recursion-guard", "input": {"tool_input": {"file_path": "{{FIXTURES}}/huge.txt"}}, "env": {"SHUNT_CHILD": "1"}, "expected_decision": "allow", "reason": "SHUNT_CHILD=1: hooks allow everything" }
  ]
}

#!/usr/bin/env python3
"""PreToolUse hook: deny full reads of large files and point at bulk-reader.
SessionStart hook: tell the model which files are large before it reads them.

Usage (from hooks.json):
  shunt-hook read            # Read tool
  shunt-hook bash            # Bash tool: cat/head/tail/less/more/rtk read
  shunt-hook session-start   # list the repo's largest files

Two rules for files over SHUNT_MIN_LINES lines:
  - a whole-file read is denied;
  - bounded reads (Read offset/limit, head, tail, rtk read --head-lines…) draw
    on a per-session, per-file budget of distinct lines (SHUNT_READ_BUDGET,
    default SHUNT_MIN_LINES), so the file can't be paged into context in
    chunks. Re-reading lines already read costs nothing.
A deny carries a model-free outline of the file (symbols and line numbers), so
the model can often Read just the range it needs instead of delegating.

Prints nothing to pass through (the normal permission flow decides), or a
hookSpecificOutput deny with a reason. Never emits "allow": that would skip the
user's permission prompts. Any internal error passes through (fails open).
SHUNT_DISABLE=1, or `scripts/shunt-toggle off` for one session, turns it off.
"""
import fcntl
import glob
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import outline  # noqa: E402
import shunt_state  # noqa: E402

DEFAULT_MIN_LINES = 600
READ_TOOL_DEFAULT_LIMIT = 2000
SEPARATORS = {";", "&&", "||", "&", "\n", ";;", "(", ")"}
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")


def env_lines(name, default):
    raw = os.environ.get(name, "")
    return int(raw) if raw.isdigit() else default


def min_lines():
    return env_lines("SHUNT_MIN_LINES", DEFAULT_MIN_LINES)


def read_budget():
    return env_lines("SHUNT_READ_BUDGET", min_lines())


def count_lines(path):
    """Line count as the Read tool sees it, or None for binary/unreadable files."""
    try:
        with open(path, "rb") as f:
            head = f.read(8192)
            if b"\0" in head:
                return None
            n, last, chunk = head.count(b"\n"), head[-1:], head
            while chunk:
                chunk = f.read(1 << 20)
                if chunk:
                    n += chunk.count(b"\n")
                    last = chunk[-1:]
    except OSError:
        return None
    return n + (1 if last and last != b"\n" else 0)


def bulk_read_cmd(path):
    root = os.environ.get("CLAUDE_PLUGIN_ROOT") or os.path.dirname(
        os.path.dirname(os.path.abspath(__file__)))
    return '{}/scripts/bulk-read --question "<your question>" --paths {}'.format(
        root, shlex.quote(path))


def merge(spans):
    """Union of inclusive (start, end) line spans, sorted and merged."""
    merged = []
    for start, end in sorted(spans):
        if merged and start <= merged[-1][1] + 1:
            merged[-1][1] = max(merged[-1][1], end)
        else:
            merged.append([start, end])
    return merged


def ledger_file(session_id):
    ledger_dir = os.path.join(tempfile.gettempdir(), "shunt-cc")
    return os.path.join(ledger_dir, re.sub(r"[^A-Za-z0-9_.-]", "_", session_id) + ".json")


def lines_read(session_id, path):
    """Distinct lines of `path` read this session so far."""
    try:
        with open(ledger_file(session_id)) as f:
            spans = json.load(f).get(os.path.realpath(path), [])
    except (OSError, ValueError, AttributeError):
        return 0
    return sum(end - start + 1 for start, end in spans)


def charge(session_id, path, span):
    """(lines of `path` read this session before, and with, `span`), recording
    the span if it stays within budget. Without a session id there is no
    ledger, so only the span itself counts."""
    budget = read_budget()
    if not session_id:
        return 0, span[1] - span[0] + 1
    name = ledger_file(session_id)
    os.makedirs(os.path.dirname(name), exist_ok=True)
    key = os.path.realpath(path)
    # Parallel tool calls run hooks concurrently: lock around read-modify-write.
    with open(name, "a+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0)
        try:
            ledger = json.loads(f.read() or "{}")
        except ValueError:
            ledger = {}
        before = sum(end - start + 1 for start, end in ledger.get(key, []))
        spans = merge(ledger.get(key, []) + [list(span)])
        covered = sum(end - start + 1 for start, end in spans)
        if covered <= budget:
            ledger[key] = spans
            f.seek(0)
            f.truncate()
            json.dump(ledger, f)
    return before, covered


def line_tokens(path, total, lines):
    """Rough tokens for `lines` lines of `path` as Read shows them (with numbers)."""
    try:
        per_line = os.path.getsize(path) / max(total, 1) + 7  # Read's "  123\t" prefix
    except OSError:
        per_line = 40
    return shunt_state.tokens(lines * per_line)


def check_large_file(path, span, session_id, verb):
    """Deny a whole or bounded read of a large file when it should be delegated."""
    total, threshold = count_lines(path), min_lines()
    if total is None or total <= threshold:
        return
    start, end = max(span[0], 1), min(span[1], total)
    if start > end:
        return
    budget = read_budget()
    if start == 1 and end == total:
        deny_large(path, total, session_id, "whole",
                   "shunt: {} is {} lines (SHUNT_MIN_LINES={}), too large to read whole{}.".format(
                       path, total, threshold, " with `{}`".format(verb) if verb else ""),
                   budget - lines_read(session_id, path))
    before, covered = charge(session_id, path, (start, end))
    if covered > budget:
        deny_large(path, total, session_id, "budget",
                   "shunt: {} is {} lines. Reading lines {}-{} would bring the lines of it "
                   "read this session to {}, over the budget of {} (SHUNT_READ_BUDGET): "
                   "paging through a large file costs as much as reading it whole.".format(
                       path, total, start, end, covered, budget),
                   budget - before)
    if covered > before:
        shunt_state.log_event("read", session=session_id, path=os.path.realpath(path),
                              lines=covered - before,
                              tokens=line_tokens(path, total, covered - before))


def deny_large(path, total, session_id, kind, headline, left):
    """Deny with an outline of the file and the two ways forward."""
    shape = outline.outline(path, total)
    parts = [headline]
    if shape:
        parts.append("Outline (line: symbol):\n" + shape)
    parts.append(
        "Next:\n"
        "- To edit, debug or review code here, Read just the ranges you need with "
        "offset/limit (line numbers from {}grep -n); {} more distinct lines of this "
        "file fit this session, and re-reads are free.\n"
        "- To understand, summarize or search the whole file, ask Haiku through the "
        "bulk-reader skill and get only the answer:\n    {}\n"
        "  Haiku's answer locates code; before you edit, or report a bug or security "
        "issue, Read the cited lines and judge them yourself.".format(
            "the outline and " if shape else "", max(left, 0), bulk_read_cmd(path)))
    reason = "\n".join(parts)
    shunt_state.log_event("deny", session=session_id, path=os.path.realpath(path), kind=kind,
                          lines=total, outline=bool(shape), tokens=shunt_state.tokens(len(reason)))
    deny(reason)


def deny(reason):
    json.dump({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}, sys.stdout)
    sys.exit(0)


# ── Read tool ────────────────────────────────────────────────────────────────

def as_int(value, default):
    try:
        n = int(value)
    except (TypeError, ValueError):
        return default
    return n if n > 0 else default


def check_read(tool_input, session_id):
    if "pages" in tool_input:
        return  # PDF page ranges: Read handles these natively
    path = tool_input.get("file_path") or ""
    if not path or not os.path.isfile(path):
        return
    if "offset" not in tool_input and "limit" not in tool_input:
        span = (1, float("inf"))
    else:
        start = as_int(tool_input.get("offset"), 1)
        span = (start, start + as_int(tool_input.get("limit"), READ_TOOL_DEFAULT_LIMIT) - 1)
    check_large_file(path, span, session_id, None)


# ── Bash tool ────────────────────────────────────────────────────────────────

def tokenize(command):
    lex = shlex.shlex(command, posix=True, punctuation_chars="();<>|&\n")
    lex.whitespace = " \t\r"
    lex.whitespace_split = True
    return list(lex)


def split_commands(tokens):
    """Split on ;, &&, ||, &, newline. Yields (words, piped) per pipeline."""
    current = []
    for tok in tokens + [";"]:
        if tok in SEPARATORS or (set(tok) <= set(";&\n") and tok):
            if current:
                yield current, any(t in ("|", "|&") for t in current)
            current = []
        else:
            current.append(tok)


def strip_redirects(words):
    """Return (words, stdin_files, stdout_redirected)."""
    out, stdin_files, redirected, i = [], [], False, 0
    while i < len(words):
        tok = words[i]
        nxt = words[i + 1] if i + 1 < len(words) else None
        if tok in (">", ">>", ">|"):
            if out and out[-1].isdigit() and out[-1] != "1":
                out.pop()  # 2>/dev/null etc: stderr still lands in context
            else:
                if out and out[-1] == "1":
                    out.pop()
                redirected = True
            i += 2
        elif tok in ("&>", "&>>"):
            redirected = True
            i += 2
        elif tok in (">&", "<&"):
            if out and out[-1].isdigit():
                out.pop()
            i += 2
        elif tok == "<":
            if nxt:
                stdin_files.append(nxt)
            i += 2
        elif tok in ("<<", "<<<", "<<-"):
            i += 2
        else:
            out.append(tok)
            i += 1
    return out, stdin_files, redirected


def unwrap(words):
    """Drop env assignments and transparent wrappers (env, command, rtk bypass…)."""
    while words:
        if ASSIGNMENT.match(words[0]):
            words = words[1:]
        elif words[0] in ("command", "builtin", "exec", "nohup", "time", "sudo"):
            words = words[1:]
        elif words[0] == "env":
            words = words[1:]
            while words and (words[0].startswith("-") or ASSIGNMENT.match(words[0])):
                words = words[1:]
        elif os.path.basename(words[0]) == "rtk" and len(words) > 1 and words[1] in ("bypass", "proxy"):
            words = words[2:]
        else:
            return words
    return words


def parse_count(value):
    """'50' -> 50, '+10' -> ('from', 10), '-5' -> ('allbut', 5); None if unparseable."""
    m = re.match(r"^([+-]?)(\d+)", value or "")
    if not m:
        return None
    n = int(m.group(2))
    return {"+": ("from", n), "-": ("allbut", n)}.get(m.group(1), n)


def head_tail(name, args):
    """Return (files, span) where span(total) is the (start, end) lines printed."""
    count, files, whole, i = 10, [], False, 0
    while i < len(args):
        a = args[i]
        if a == "--":
            files += args[i + 1:]
            break
        if a in ("-n", "--lines") and i + 1 < len(args):
            count = parse_count(args[i + 1])
            i += 2
            continue
        if a in ("-c", "--bytes") or a.startswith(("-c", "--bytes=")):
            return [], None  # byte ranges are bounded; not a line read
        if a.startswith("--lines="):
            count = parse_count(a.split("=", 1)[1])
        elif re.match(r"^-n[+-]?\d", a):
            count = parse_count(a[2:])
        elif re.match(r"^-\d", a) or (name == "tail" and re.match(r"^\+\d", a)):
            count = parse_count(a if a.startswith("+") else a[1:])
        elif a == "-r" and name == "tail":
            whole = True  # BSD tail -r prints the whole file reversed by default
        elif not a.startswith("-") or a == "-":
            files.append(a)
        i += 1

    explicit = count != 10

    def span(total):
        if (whole and not explicit) or count is None:
            return 1, total
        kind, n = count if isinstance(count, tuple) else ("count", count)
        if kind == "from":  # tail -n +K: line K to end; head -n +K == head -n K
            return (n, total) if name == "tail" else (1, n)
        if kind == "allbut" and name == "head":  # GNU head -n -K: all but last K
            return 1, total - n
        return (1, n) if name == "head" else (total - n + 1, total)

    return files, span


def rtk_read(args):
    bound, kind, files, i = None, None, [], 0
    while i < len(args):
        a = args[i]
        if a in ("-l", "--level"):
            i += 2
            continue
        if a in ("-m", "--max-lines", "--head-lines", "--tail-lines") and i + 1 < len(args):
            n = parse_count(args[i + 1])
            if isinstance(n, int):
                bound, kind = n, a
            i += 2
            continue
        m = re.match(r"^--(max-lines|head-lines|tail-lines)=(\d+)$", a)
        if m:
            bound, kind = int(m.group(2)), "--" + m.group(1)
        elif not a.startswith("-"):
            files.append(a)
        i += 1
    def span(total):
        if bound is None:
            return 1, total
        # --max-lines is a structural preview, not a contiguous range; count it
        # as the first N lines.
        return (total - bound + 1, total) if kind == "--tail-lines" else (1, bound)

    return files, span


def full(args):
    files, rest = [], False
    for a in args:
        if rest or (not a.startswith(("-", "+")) and a != "-"):
            files.append(a)
        elif a == "--":
            rest = True
    return files, (lambda total: (1, total))


def read_targets(words):
    """Map a simple command to (verb, files, span) or None if it isn't a file read."""
    words = unwrap(words)
    if not words:
        return None
    name, args = os.path.basename(words[0]), words[1:]
    if name in ("cat", "less", "more"):
        return (name,) + full(args)
    if name in ("head", "tail"):
        files, span = head_tail(name, args)
        return (name, files, span) if span else None
    if name == "rtk" and args and args[0] in ("read", "cat"):
        return ("rtk " + args[0],) + rtk_read(args[1:])
    return None


def resolve(path, cwd):
    path = os.path.expandvars(os.path.expanduser(path))
    if not os.path.isabs(path):
        path = os.path.join(cwd, path)
    if any(c in path for c in "*?["):
        return sorted(glob.glob(path))
    return [path]


def check_bash(tool_input, cwd, session_id):
    command = tool_input.get("command") or ""
    if not command.strip():
        return
    for words, piped in split_commands(tokenize(command)):
        words, stdin_files, redirected = strip_redirects(words)
        unwrapped = unwrap(words)
        if unwrapped[:1] == ["cd"]:
            target = unwrapped[1] if len(unwrapped) > 1 else "~"
            if target != "-":
                cwd = (resolve(target, cwd) or [cwd])[0]
            continue
        if piped or redirected:
            continue
        target = read_targets(words)
        if not target:
            continue
        verb, files, span = target
        for f in files or stdin_files:
            for path in resolve(f, cwd):
                if os.path.isfile(path):
                    total = count_lines(path)
                    if total:
                        check_large_file(path, span(total), session_id, verb)

# ── SessionStart ─────────────────────────────────────────────────────────────

LIST_TIME_BUDGET = 3.0  # seconds of line counting before giving up on the rest


def largest_files(cwd, threshold, limit):
    """[(lines, relpath)] for the largest tracked text files over threshold.

    Sizes come from stat; only the biggest candidates are line-counted, under
    a time budget, so this stays fast in big repos. Outside git: nothing.
    """
    try:
        out = subprocess.run(["git", "-C", cwd, "ls-files", "-z"], capture_output=True,
                             timeout=3).stdout.decode("utf-8", errors="replace")
    except (OSError, subprocess.SubprocessError):
        return []
    sized = []
    for rel in filter(None, out.split("\0")):
        try:
            size = os.path.getsize(os.path.join(cwd, rel))
        except OSError:
            continue
        if size > threshold * 8:  # below ~8 bytes a line, it can't be over threshold
            sized.append((size, rel))
    sized.sort(reverse=True)
    found, started = [], time.time()
    for _, rel in sized[:200]:
        if time.time() - started > LIST_TIME_BUDGET:
            break
        n = count_lines(os.path.join(cwd, rel))
        if n and n > threshold:
            found.append((n, rel))
    return sorted(found, reverse=True)[:limit]


def session_start(cwd, session_id):
    limit = env_lines("SHUNT_LIST_LARGEST", 8)
    if not limit:
        return
    threshold = min_lines()
    files = largest_files(cwd, threshold, limit)
    if not files:
        return
    context = (
        "shunt-cc: whole-file reads of files over {} lines are denied here. The "
        "largest tracked files: {}. For these, find lines with grep -n and Read narrow "
        "ranges; to understand or survey one, use the bulk-reader skill.".format(
            threshold, ", ".join("{} ({:,} lines)".format(rel, n) for n, rel in files)))
    shunt_state.log_event("list", session=session_id, files=len(files),
                          tokens=shunt_state.tokens(len(context)))
    json.dump({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                      "additionalContext": context}}, sys.stdout)


def main():
    if os.environ.get("SHUNT_CHILD"):
        return  # recursion guard: never interfere inside a shunt child
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        payload = json.load(sys.stdin)
        tool_input = payload.get("tool_input") or {}
        session_id = payload.get("session_id") or ""
        if shunt_state.disabled(session_id):
            return
        cwd = payload.get("cwd") or os.getcwd()
        if mode == "read":
            check_read(tool_input, session_id)
        elif mode == "bash":
            check_bash(tool_input, cwd, session_id)
        elif mode == "session-start":
            session_start(cwd, session_id)
    except SystemExit:
        raise
    except Exception as e:  # fail open: a hook bug must never block work
        print("shunt-hook: {}: {}".format(type(e).__name__, e), file=sys.stderr)


if __name__ == "__main__":
    main()

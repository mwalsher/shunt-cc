#!/usr/bin/env python3
"""Ask Haiku a question about large files via headless Claude Code.

Usage: bulk-read --question "what does this do?" --paths file1 [file2 ...]

Files go to the child on stdin, wrapped in <file path="..."> tags with line
numbers, in a prompt-cached block: follow-up questions about the same paths
within the cache TTL are much cheaper. Only the answer is printed, followed by
a check of its citations against the files (lib/verify.py, no model); a rough
token note goes to stderr. Each call is logged for `shunt-report`.
"""
import argparse
import glob
import html
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import shunt_state  # noqa: E402
import verify  # noqa: E402

SYSTEM_PROMPT = (
    "You answer one question about the files given in <file path=\"...\"> tags, "
    "for another model that will read the code you point to and decide what it "
    "means. Each file line starts with its line number and a tab; the number is "
    "not part of the code. Answer only from the files, in terse bullets. For each "
    "point, write path:line or path:start-end and right after it the key line from "
    "there in backticks, copied exactly without the line number; that first quote "
    "is checked against the cited lines. Say what the code is and does, not "
    "whether it is correct, safe or well designed: no severity or confidence "
    "ratings. If the question asks for bugs, risks or a review, list the places "
    "worth checking as leads, each with the facts that make it one (for example, "
    "a parameter concatenated into a shell command), and leave the verdict to the "
    "reader. Claim something is absent only for a name or call you looked for, and "
    "name it (\"no call to eval or pickle\"), never \"no issues\". If the files "
    "do not answer the question, say so. Then, under \"Related code:\", cite up to "
    "three places the question did not ask about that touch the same names or "
    "state: other callers or writers, a comment or docstring on the cited code, a "
    "second definition. Quote them the same way and say what each is, without "
    "judging it; leave the section out if there are none. No preamble, no closing "
    "summary."
)


def fail(msg, code=1):
    print("bulk-read: error: " + msg, file=sys.stderr)
    sys.exit(code)


def env_int(name, default):
    raw = os.environ.get(name, "")
    return int(raw) if raw.isdigit() and int(raw) > 0 else default


def find_claude():
    # HOME and PATH can be stripped (sandboxes, GUI apps), so also look in the
    # standard install locations under the real home directory, and in the
    # newest binary bundled with the Desktop app.
    home = pwd.getpwuid(os.getuid()).pw_dir
    bundled = sorted(glob.glob(os.path.join(
        home, "Library/Application Support/Claude/claude-code/*/*/claude.app/Contents/MacOS/claude")),
        key=os.path.getmtime, reverse=True)
    for candidate in [os.environ.get("SHUNT_CLAUDE_BIN"), shutil.which("claude"),
                      os.environ.get("CLAUDE_CODE_EXECPATH"),
                      os.path.join(home, ".local/bin/claude"),
                      os.path.join(home, ".claude/local/claude"),
                      "/opt/homebrew/bin/claude", "/usr/local/bin/claude"] + bundled:
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    fail("claude CLI not found; install it or set SHUNT_CLAUDE_BIN")


def display_names(paths):
    """Names for the <file> tags. Haiku repeats them in every citation, so use
    the basename when it's unique among the paths, else the path as given."""
    base = [os.path.basename(p) for p in paths]
    return [b if base.count(b) == 1 else p for p, b in zip(paths, base)]


def build_files(paths):
    parts = []
    for path, name in zip(paths, display_names(paths)):
        with open(path, "rb") as f:
            data = f.read()
        if b"\0" in data[:8192]:
            fail("binary file, not sending: " + path)
        lines = data.decode("utf-8", errors="replace").splitlines()
        numbered = "\n".join("{}\t{}".format(n, line) for n, line in enumerate(lines, 1))
        parts.append('<file path="{}">\n{}\n</file>\n'.format(
            html.escape(name, quote=True), numbered))
    return "\n".join(parts)


def user_message(files, question, ttl):
    """One stream-json user turn: files and question in separate blocks.

    The files block carries its own cache breakpoint, so a follow-up question
    about the same paths reads the files from the prompt cache instead of
    paying for them again.
    """
    files_block = {"type": "text", "text": files}
    if ttl != "off":
        files_block["cache_control"] = {"type": "ephemeral", "ttl": ttl}
    question_block = {"type": "text", "text": "<question>\n{}\n</question>".format(question)}
    return json.dumps({"type": "user", "message": {
        "role": "user", "content": [files_block, question_block]}}) + "\n"


def last_result(stdout):
    result = {}
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if isinstance(event, dict) and event.get("type") == "result":
            result = event
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--question", required=True)
    parser.add_argument("--paths", required=True, nargs="+")
    args = parser.parse_args()

    if os.environ.get("SHUNT_CHILD"):
        fail("refusing to run inside a shunt child (SHUNT_CHILD is set)")
    if not args.question.strip():
        fail("--question is empty")

    # Check every path up front: Haiku would happily answer about a file it never saw.
    missing = [p for p in args.paths if not (os.path.isfile(p) and os.access(p, os.R_OK))]
    if missing:
        fail("file not found or unreadable: " + ", ".join(missing))

    model = os.environ.get("SHUNT_MODEL") or "claude-haiku-5-5"
    effort = os.environ.get("SHUNT_EFFORT") or "medium"
    timeout = env_int("SHUNT_TIMEOUT", 300)
    ttl = os.environ.get("SHUNT_CACHE_TTL") or "1h"
    if ttl not in ("1h", "5m", "off"):
        fail("SHUNT_CACHE_TTL must be 1h, 5m or off")
    files = build_files(args.paths)
    line_count = len(re.findall(r"^\d+\t", files, re.M))

    cmd = [
        find_claude(), "-p",
        "--model", model,
        "--effort", effort,
        "--system-prompt", SYSTEM_PROMPT,
        "--tools", "",
        "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
        "--setting-sources", "",
        "--disable-slash-commands",
        "--no-session-persistence",
        "--input-format", "stream-json",
        "--output-format", "stream-json", "--verbose",
    ]
    env = dict(os.environ, SHUNT_CHILD="1")
    env.pop("CLAUDE_EFFORT", None)  # the parent session's effort must not override --effort

    # The API rejects a 1h breakpoint after a 5m one, and Claude Code picks its
    # own TTL, so on a TTL error retry with the other TTL, then with none.
    ttls = [ttl] + [t for t in ("1h", "5m", "off") if t != ttl and ttl != "off"]
    started = time.time()
    child = {"input": 0, "cache_write": 0, "cache_read": 0, "output": 0, "cost_usd": 0.0}

    def record(ok, **extra):
        """Log this call for shunt-report. `tokens` estimates what reading the
        files whole would have put in the main context."""
        shunt_state.log_event(
            "delegate", ok=ok, session=os.environ.get("CLAUDE_CODE_SESSION_ID", ""),
            cwd=os.getcwd(), model=model, effort=effort,
            paths=[os.path.realpath(p) for p in args.paths], lines=line_count,
            tokens=shunt_state.tokens(len(files)), child=child,
            seconds=round(time.time() - started, 1), **extra)

    # Run from an empty directory so the child discovers no project CLAUDE.md.
    with tempfile.TemporaryDirectory(prefix="shunt-") as cwd:
        for attempt in ttls:
            try:
                proc = subprocess.run(cmd, input=user_message(files, args.question, attempt),
                                      capture_output=True, text=True, cwd=cwd, env=env,
                                      timeout=timeout)
            except subprocess.TimeoutExpired:
                record(False, error="timeout")
                fail("{} timed out after {}s (raise SHUNT_TIMEOUT)".format(model, timeout), 124)
            result = last_result(proc.stdout)
            add_usage(child, result)
            answer = (result.get("result") or "").strip()
            if not (result.get("is_error") and "cache_control" in answer):
                break

    stderr_tail = proc.stderr.strip()[-2000:]
    error = None
    if proc.returncode != 0:
        error = "claude exited {}: {}".format(proc.returncode, answer or stderr_tail or proc.stdout.strip()[-2000:])
    elif result.get("is_error") or result.get("subtype", "success") != "success":
        error = "{} returned an error ({}): {}".format(model, result.get("subtype"), answer or stderr_tail)
    elif not answer:
        error = "{} returned an empty answer{}".format(model, ": " + stderr_tail if stderr_tail else "")
    if error:
        record(False, error=error[:200])
        fail(error)

    summary, footer = verify.check(answer, args.paths)
    output = answer + "\n\n" + footer
    print(output)
    record(True, answer_tokens=shunt_state.tokens(len(output)), verify=summary,
           cache_hit=child["cache_read"] > 1000)
    print("[shunt: ~{} input tokens ({} files{}) -> {} ({}), {:.0f}s]".format(
        len(files) // 4, len(args.paths), ", cache hit" if child["cache_read"] > 1000 else "",
        model, effort, time.time() - started), file=sys.stderr)


def add_usage(child, result):
    """Add one child run's usage and cost to the running totals."""
    usage = result.get("usage") or {}
    for key, field in (("input", "input_tokens"), ("cache_write", "cache_creation_input_tokens"),
                       ("cache_read", "cache_read_input_tokens"), ("output", "output_tokens")):
        child[key] += int(usage.get(field) or 0)
    child["cost_usd"] = round(child["cost_usd"] + float(result.get("total_cost_usd") or 0), 6)

if __name__ == "__main__":
    main()
